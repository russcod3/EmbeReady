# ══════════════════════════════════════════════════════════════════════════════
#  EmbeReady — Environment Configuration
#  Copy this file to .env and fill in your values.
#  .env is gitignored and must NEVER be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Gemini — the only assessment provider ────────────────────────────────────
# New community reports use Gemini. Existing demo results load without API calls.
# Failed real reports have no fabricated scoring fallback.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_MODE=interactions
GEMINI_TIMEOUT_MS=120000

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ── Rate limiting (reports) ───────────────────────────────────────────────────
# Max number of report submissions per IP within the window
RATE_LIMIT_MAX=5
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
